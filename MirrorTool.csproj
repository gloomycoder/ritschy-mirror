<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK TFM (instead of net9.0-windows): unlocks the WinRT projections, including
         Windows.Graphics.Capture (WGC) for window/fullscreen-app capture. WinForms stays.
         API surface 22621 (so IsBorderRequired is known), but runtime floor 19041 → the app
         keeps running on Windows 10 (2004+, the WGC minimum); newer APIs are
         version-guarded at runtime (OperatingSystem.IsWindowsVersionAtLeast). -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>RitschyMirror</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.4.13</Version>
    <Product>RitschyMirror</Product>
    <Company>RitschyRigz</Company>
    <Description>Screen Mirror Tool for capture cards (HDR-to-SDR tonemapping)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
    <!-- WASAPI loopback capture + shared-mode render for the audio mirror (MIT). -->
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default render config → config\ in the output (see AppPaths for the folder layout). -->
    <None Update="mirror_config.json">
      <Link>config\mirror_config.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Icons for tray + window (fixed LogicalName so AppIcon.Load finds them).
         app.ico = base (window), app_on/off = tray status green/red. -->
    <EmbeddedResource Include="assets\app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\app_on.ico">
      <LogicalName>app_on.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\app_off.ico">
      <LogicalName>app_off.ico</LogicalName>
    </EmbeddedResource>
    <!-- OBS/browser control dock, served by the HTTP agent at / and /dock. -->
    <EmbeddedResource Include="web\dock.html">
      <LogicalName>dock.html</LogicalName>
    </EmbeddedResource>
    <!-- Built-in language packs (lang.<code>.json); lang\*.json next to the exe overrides/extends them. -->
    <EmbeddedResource Include="lang\*.json">
      <LogicalName>lang.%(Filename).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Normal builds: keep the exe folder tidy — dependency assemblies are moved to bin\ and loaded
       from there by Program.ResolveFromBin. No deps.json, otherwise the host insists on finding them
       next to the exe. A single-file publish bundles everything into the exe and is left alone. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' != 'true'">
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <Target Name="MoveDependenciesToBin" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_DependencyDll Include="$(OutDir)*.dll" Exclude="$(OutDir)$(AssemblyName).dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_DependencyDll)" DestinationFolder="$(OutDir)bin" SkipUnchangedFiles="true" />
    <Delete Files="@(_DependencyDll)" />
  </Target>

</Project>
